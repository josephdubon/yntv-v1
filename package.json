{
  "name": "yeshua-network",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@material-ui/core": "4.10.1",
    "@material-ui/icons": "4.9.1",
    "animate.css": "4.1.0",
    "classnames": "2.2.6",
    "history": "4.10.1",
    "moment": "2.29.4",
    "netlify-cli": "^3.8.4",
    "node-sass": "4.14.1",
    "nouislider": "14.5.0",
    "prop-types": "15.7.2",
    "react": "16.13.1",
    "react-animate-on-scroll": "2.1.5",
    "react-datetime": "2.16.3",
    "react-datetime-picker": "^3.1.0",
    "react-dom": "16.13.1",
    "react-google-maps": "^9.4.5",
    "react-image-gallery": "1.0.7",
    "react-router": "^5.2.0",
    "react-router-dom": "5.2.0",
    "react-scripts": "3.4.1",
    "react-slick": "0.26.1",
    "react-swipeable-views": "0.13.9",
    "react-tagsinput": "3.19.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && gulp licenses",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "lint:check": "eslint . --ext=js,jsx;  exit 0",
    "lint:fix": "eslint . --ext=js,jsx --fix;  exit 0",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "node-sass src/assets/scss/yeshua-network.scss src/assets/css/yeshua-network.css",
    "minify-sass": "node-sass src/assets/scss/yeshua-network.scss src/assets/css/yeshua-network.min.css --output-style compressed",
    "map-sass": "node-sass src/assets/scss/yeshua-network.scss src/assets/css/yeshua-network.css --source-map true"
  },
  "devDependencies": {
    "gulp": "^4.0.2",
    "gulp-append-prepend": "^1.0.8"
  },
  "optionalDependencies": {
    "@types/googlemaps": "^3.43.3",
    "@types/markerclustererplus": "^2.1.33",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-prettier": "^3.3.1",
    "eslint-plugin-react": "^7.22.0",
    "prettier": "^2.2.1",
    "typescript": "^4.1.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
